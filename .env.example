# LenderLens environment variables.
#
# Copy to .env.local and fill in real values. .env.local is git-ignored and must
# never be committed. NOTHING IN THIS FILE IS A REAL SECRET — every value below
# is a placeholder.
#
# The application runs a full verification with none of these set. They enable
# the durable store, the model registry, the audit log, stable rate-limit
# buckets and the optional domain-age signal.


# --- Supabase (optional) -----------------------------------------------------
# Holds the durable copy of the RBI corpus, the ML model registry and the
# privacy-conscious verification audit log. None of it is on the critical path
# of a request: verification reads the compiled index on disk, so a check still
# works when Supabase is unreachable. /api/health reports the difference.
#
# Project URL from the Supabase dashboard (Settings -> API).
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key. SERVER-SIDE ONLY.
# It bypasses Row Level Security, so it must never appear in browser code.
# Everything that touches it is guarded by the `server-only` package, which
# makes importing it from a Client Component a build error.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key


# --- Rate limiting (recommended in production) -------------------------------
# A server-side secret used to derive rate-limit bucket keys as
#   SHA-256(pepper || client identifier)
# and to digest lender names in the audit log. Without the pepper, the hash of
# an IPv4 address would be trivially reversible by enumerating the address
# space, so a plain hash is not enough.
#
# At least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Absent, a random value is generated per process: correct for development and
# for a single instance, but buckets do not survive a restart or span replicas.
# /api/health reports which of the two is in use. NEVER COMMIT THE REAL VALUE.
# RATE_LIMIT_PEPPER=replace-with-32-random-bytes-hex


# --- Domain age (optional) ---------------------------------------------------
# Enables the "how old is this domain?" signal in the website layer. With no key
# set the signal reports itself unavailable and every other check is unaffected.
# WHOIS_API_PROVIDER=whoisxmlapi
# WHOIS_API_KEY=your-whois-api-key


# --- Gemini investigation (optional) -----------------------------------------
# Enables the fallback AI investigation for lending domains the RBI reference
# data cannot resolve. With no key set, verification is unchanged and the
# investigation reports itself unavailable - nothing else in the app depends on
# it.
#
# Get a key from Google AI Studio (aistudio.google.com/apikey). The Gemini API
# free tier is sufficient: the investigation uses a Flash-class model, a JSON
# response schema and the URL-context retrieval tool, none of which require
# Google Cloud billing.
#
# SERVER-SIDE ONLY. There is deliberately no NEXT_PUBLIC_ variant: the key is
# read inside a module guarded by the `server-only` package, so importing it
# from a Client Component is a build error rather than a leaked key.
# NEVER COMMIT THE REAL VALUE.
# GEMINI_API_KEY=

# Optional. Overrides the model. Defaults to gemini-3.5-flash, which a new
# free-tier key can call and which supports a response schema and the
# URL-context tool together. The 2.5 Flash models are no longer offered to new
# keys.
# GEMINI_MODEL=gemini-3.5-flash

# Optional. The model used for the single cheap extraction step (reading the
# operator's name out of the page). Defaults to gemini-3.5-flash-lite. The free
# tier counts requests PER MODEL, so keeping this different from GEMINI_MODEL
# roughly doubles how many investigations a free key can run in a day.
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# Optional. Adds Grounding with Google Search to the investigation's retrieval
# step. OFF by default: a free-tier key with no search allowance answers a
# grounded request with a quota error instead of an answer, so it is only worth
# enabling on a key that has one. Retrieval works without it.
# GEMINI_ENABLE_SEARCH_GROUNDING=false
